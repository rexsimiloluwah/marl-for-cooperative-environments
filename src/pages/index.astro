---
/**
 * LANDING PAGE
 *
 * A standalone route rather than a Starlight page, because the design is
 * full-width banded sections and Starlight's article shell would fight that
 * at every step. It shares the same tokens, the same icon set and the same
 * theme machinery, so nothing here is a visual fork.
 */
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/theme.css';
import '../styles/components.css';

import ThemeProvider from '../components/overrides/ThemeProvider.astro';
import ThemeSelect from '../components/overrides/ThemeSelect.astro';
import Icon from '../components/ui/Icon.astro';
import AgentsGoal from '../components/landing/AgentsGoal.astro';
import WirelessScene from '../components/landing/WirelessScene.astro';

const TITLE = 'Multi-Agent Reinforcement Learning for Cooperative Environments';
const DESCRIPTION =
  'An interactive undergraduate resource on cooperative multi-agent reinforcement learning: learning to coordinate, communicate, and adapt, with executable code, a wireless resource-allocation lab, and a design project.';

/** The three core chapters. Background is prerequisite reading before these. */
const journey = [
  {
    n: '01',
    title: 'Coordinate',
    icon: 'users-round',
    blurb: 'Learn how agents align their actions toward a common goal.',
    href: '/coordinate/coordination/',
    lab: { label: 'Lab 01', href: '/lab/experiment-coordinate/' },
  },
  {
    n: '02',
    title: 'Communicate',
    icon: 'message',
    blurb: 'Share information to overcome limits in what each agent can see.',
    href: '/communicate/communication-in-marl/',
    lab: { label: 'Lab 02', href: '/lab/experiment-communicate/' },
  },
  {
    n: '03',
    title: 'Adapt',
    icon: 'cycle',
    blurb: 'Generalize to new teammates and situations, not just familiar ones.',
    href: '/adapt/partner-dependence/',
    lab: { label: 'Lab 03', href: '/lab/experiment-adapt/' },
  },
];

const resources = [
  {
    icon: 'monitor',
    title: 'Interactive Tutorial Website',
    blurb:
      'Learn each concept through clear explanations, visual examples, interactive demonstrations, and real-world connections.',
    href: '/introduction/',
  },
  {
    icon: 'code',
    title: 'Hands-On Practical Notebooks',
    blurb:
      'Implement key ideas, run experiments, analyse results, and explore how multi-agent systems behave.',
    href: '/resources/notebooks/',
  },
  {
    icon: 'flag',
    title: 'Challenge Lab',
    blurb:
      'Transfer all three ideas to a wireless network: coordinate channels, price communication, and meet an access point you did not train.',
    href: '/lab/overview/',
  },
  {
    icon: 'beaker',
    title: 'Final Project',
    blurb:
      'Design a cooperative multi-agent disaster response system, and the evaluation that could prove it does not work.',
    href: '/project/brief/',
  },
  {
    icon: 'clipboard',
    title: 'Worksheets',
    blurb:
      'Guided exercises and activities for working through concepts, experiments, and problems at your own pace.',
    href: '/resources/worksheets/',
  },
  {
    icon: 'check-square',
    title: 'Knowledge Checks',
    blurb:
      'Short questions embedded throughout the course to test your understanding and provide immediate feedback.',
    href: '/resources/knowledge-checks/',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={Astro.site ? new URL('/', Astro.site).href : '/'} />
    <ThemeProvider />
  </head>

  <body class="lp">
    <a class="lp__skip" href="#start">Skip to content</a>

    <header class="lp__header">
      <a class="lp__brand" href="/">
        <span class="lp__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
            <path d="M7 8 L17 8 M7 8 L12 17 M17 8 L12 17" stroke="var(--rule-strong)" stroke-width="1.3"></path>
            <circle cx="7" cy="8" r="3" fill="var(--ui)"></circle>
            <circle cx="17" cy="8" r="3" fill="var(--c-action)"></circle>
            <circle cx="12" cy="17" r="3" fill="var(--c-reward)"></circle>
          </svg>
        </span>
        <span>MARL in Cooperative Environments</span>
      </a>
      <nav class="lp__nav" aria-label="Site">
        <a href="/introduction/">Course</a>
        <a href="/lab/overview/">Lab</a>
        <a href="/project/brief/">Project</a>
        <a href="/resources/references/">Resources</a>
      </nav>
      <ThemeSelect />
    </header>

    <main id="start">
      <!-- ================= HERO ================= -->
      <section class="hero">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">Interactive learning resource</p>
            <h1 class="hero__title">{TITLE}</h1>
            <p class="hero__sub">Learning to Coordinate, Communicate, and Adapt</p>
            <p class="hero__body">
              Explore how multiple agents learn to work together toward shared
              goals in changing environments.
            </p>
            <div class="hero__actions">
              <a class="btn btn--primary btn--lg" href="/introduction/">
                Start Learning
                <Icon name="chevron-right" size={16} />
              </a>
              <a class="btn btn--lg" href="/lab/overview/">Open the Lab</a>
            </div>
            <p class="hero__meta">
              Advanced undergraduate level · roughly 8 to 12 hours · no prior
              MARL, game theory or wireless background assumed
            </p>
          </div>
          <div class="hero__art">
            <AgentsGoal />
          </div>
        </div>
      </section>

      <!-- ================= JOURNEY ================= -->
      <section class="band">
        <div class="band__inner">
          <header class="band__head">
            <h2>Your Learning Journey</h2>
            <p>
              Three chapters, three labs. Each chapter answers one question
              that the previous chapter makes unavoidable.
            </p>
          </header>

          <ol class="journey">
            {
              journey.map((step, i) => (
                <li class="jc">
                  <div class="jc__top">
                    <span class="jc__n">{step.n}</span>
                    <Icon name={step.icon} size={22} class="jc__icon" />
                  </div>
                  <h3><a href={step.href}>{step.title}</a></h3>
                  <p class="jc__blurb">{step.blurb}</p>
                  <ul class="jc__list">
                    <li>
                      <Icon name="book" size={16} />
                      <span><strong>Read &amp; Explore</strong>Interactive content and examples</span>
                    </li>
                    <li>
                      <Icon name="check-square" size={16} />
                      <span><strong>Knowledge Checks</strong>Test your reasoning as you go</span>
                    </li>
                    <li>
                      <Icon name="beaker" size={16} />
                      <span><strong>{step.lab.label}</strong>Hands-on experiments</span>
                    </li>
                  </ul>
                  {i < journey.length - 1 && (
                    <span class="jc__arrow" aria-hidden="true">
                      <Icon name="chevron-right" size={15} />
                    </span>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ================= CHALLENGE LAB + PROJECT ================= -->
      <section class="band band--alt">
        <div class="band__inner">
          <div class="challenge">
            <div class="challenge__copy">
              <p class="eyebrow">Apply it to the real world</p>
              <h2>Challenge Lab</h2>
              <p class="challenge__sub">Wireless Network Resource Allocation</p>
              <p>
                Several base stations serve users over a limited set of
                channels. Each station chooses a channel and a transmit power
                using only what it can measure locally. Choose well and the
                network carries more traffic; choose the same channel as your
                neighbour and you both lose.
              </p>
              <a class="btn btn--primary" href="/lab/overview/">
                Go to Challenge Lab
                <Icon name="chevron-right" size={15} />
              </a>
            </div>
            <div class="challenge__art">
              <WirelessScene />
            </div>
          </div>

          <div class="project">
            <div class="project__copy">
              <p class="eyebrow">Create something of your own</p>
              <h2>Final Project</h2>
              <p>
                Design and justify a cooperative resource-allocation system:
                choose the observations, the actions, the reward, the
                communication scheme and the training conditions, then defend
                your deployment decision with measured evidence.
              </p>
              <a class="btn btn--primary" href="/project/brief/">
                Start Final Project
                <Icon name="chevron-right" size={15} />
              </a>
            </div>
            <ul class="project__facts">
              <li><strong>Apply</strong> build on the lab environment</li>
              <li><strong>Analyse</strong> seven evaluation scenarios</li>
              <li><strong>Evaluate</strong> throughput against fairness</li>
              <li><strong>Create</strong> propose an improved system</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ================= RESOURCES ================= -->
      <section class="band">
        <div class="band__inner">
          <header class="band__head band__head--left">
            <h2>Resources</h2>
            <p>
              Everything you need to learn, practise, and explore cooperative
              multi-agent reinforcement learning.
            </p>
          </header>
          <ul class="res">
            {
              resources.map((r) => (
                <li>
                  <a href={r.href}>
                    <span class="res__icon"><Icon name={r.icon} size={22} /></span>
                    <strong>{r.title}</strong>
                    <span class="res__blurb">{r.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="lp__footer">
      <p>&copy; MARL for Cooperative Environments, 2026</p>
    </footer>

    <style>
      /* ---------- shell ---------- */
      .lp {
        margin: 0;
        background: var(--surface);
      }

      .lp__skip {
        position: absolute;
        left: -9999px;
      }
      .lp__skip:focus {
        left: var(--s-4);
        top: var(--s-4);
        z-index: 10;
        padding: var(--s-2) var(--s-3);
        background: var(--surface);
        border: var(--hairline) solid var(--ui);
        border-radius: var(--r-sm);
      }

      .lp__header {
        display: flex;
        align-items: center;
        gap: var(--s-5);
        padding: var(--s-3) var(--s-5);
        background: var(--surface);
        border-bottom: var(--hairline) solid var(--rule);
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .lp__brand {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        font-size: 1rem;
        font-weight: var(--w-bold);
        letter-spacing: var(--tr-heading);
        color: var(--ink);
        text-decoration: none;
        min-width: 0;
      }

      .lp__mark { display: flex; flex: none; }

      .lp__nav {
        display: none;
        margin-inline-start: auto;
        gap: var(--s-1);
      }

      .lp__nav a {
        padding: 0.35rem var(--s-3);
        border-radius: var(--r-sm);
        font-size: var(--t-meta);
        color: var(--ink-muted);
        text-decoration: none;
      }
      .lp__nav a:hover { background: var(--surface-hover); color: var(--ink); }

      @media (min-width: 52rem) {
        .lp__nav { display: flex; }
      }
      @media (max-width: 52rem) {
        .lp__header > :global(.theme) { margin-inline-start: auto; }
      }

      /* ---------- shared ---------- */
      .eyebrow {
        margin: 0 0 var(--s-3);
        font-size: var(--t-micro);
        font-weight: var(--w-semibold);
        letter-spacing: var(--tr-label);
        text-transform: uppercase;
        color: var(--ui);
      }

      .btn--lg {
        min-height: 2.75rem;
        padding-inline: var(--s-5);
        font-size: var(--t-meta);
      }

      .band {
        padding: var(--s-8) var(--s-5);
        background: var(--surface);
      }

      .band--alt {
        background: var(--ground);
        border-block: var(--hairline) solid var(--rule);
      }

      .band__inner {
        max-width: 68rem;
        margin-inline: auto;
      }

      .band__head {
        text-align: center;
        max-width: 40rem;
        margin: 0 auto var(--s-6);
      }

      .band__head--left {
        text-align: left;
        margin-inline: 0;
      }

      .band__head h2 {
        margin: 0 0 var(--s-2);
        font-size: 1.75rem;
        font-weight: var(--w-bold);
        letter-spacing: var(--tr-heading);
      }

      .band__head p {
        margin: 0;
        color: var(--ink-muted);
        font-size: var(--t-meta);
      }

      /* ---------- hero ---------- */
      .hero {
        padding: var(--s-8) var(--s-5) var(--s-9);
        background: color-mix(in srgb, var(--ui) 6%, var(--surface));
        border-bottom: var(--hairline) solid var(--rule);
      }

      .hero__inner {
        display: grid;
        gap: var(--s-7);
        max-width: 68rem;
        margin-inline: auto;
        align-items: center;
      }

      @media (min-width: 60rem) {
        .hero__inner {
          grid-template-columns: 1.05fr 1fr;
          gap: var(--s-6);
        }
      }

      .hero__title {
        margin: 0 0 var(--s-3);
        font-size: clamp(2rem, 4.4vw, 3rem);
        line-height: 1.08;
        font-weight: var(--w-bold);
        letter-spacing: -0.028em;
        text-wrap: balance;
      }

      .hero__sub {
        margin: 0 0 var(--s-4);
        font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
        font-weight: var(--w-semibold);
        color: var(--ui);
        letter-spacing: -0.01em;
      }

      .hero__body {
        margin: 0 0 var(--s-5);
        max-width: 34rem;
        color: var(--ink-muted);
        line-height: 1.62;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-3);
      }

      .hero__meta {
        margin: var(--s-5) 0 0;
        font-size: var(--t-small);
        color: var(--ink-faint);
        max-width: 32rem;
      }

      /* ---------- journey ---------- */
      .journey {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--s-5);
      }

      @media (min-width: 56rem) {
        .journey {
          grid-template-columns: repeat(3, 1fr);
          gap: var(--s-6);
        }
      }

      .jc {
        position: relative;
        padding: var(--s-5);
        background: var(--surface);
        border: var(--hairline) solid var(--rule);
        border-radius: var(--r-lg);
      }

      .jc__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--s-3);
      }

      .jc__n {
        display: grid;
        place-items: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: var(--r-full);
        background: var(--ui);
        color: #fff;
        font-size: var(--t-small);
        font-weight: var(--w-bold);
        font-variant-numeric: tabular-nums;
      }

      .jc__icon { color: var(--ui); opacity: 0.55; }

      .jc h3 {
        margin: 0 0 var(--s-2);
        font-size: 1.1875rem;
        font-weight: var(--w-bold);
        letter-spacing: var(--tr-heading);
      }

      .jc h3 a { color: var(--ink); text-decoration: none; }
      .jc h3 a:hover { color: var(--ui); }

      .jc__blurb {
        margin: 0 0 var(--s-4);
        font-size: var(--t-meta);
        color: var(--ink-muted);
        line-height: 1.5;
      }

      .jc__list {
        list-style: none;
        margin: 0;
        padding: var(--s-4) 0 0;
        border-top: var(--hairline) solid var(--rule);
        display: grid;
        gap: var(--s-3);
      }

      .jc__list li {
        display: flex;
        align-items: flex-start;
        gap: var(--s-3);
        color: var(--ui);
      }

      .jc__list span {
        display: grid;
        gap: 0.1rem;
        font-size: var(--t-small);
        color: var(--ink-faint);
        line-height: 1.4;
      }

      .jc__list strong {
        font-size: var(--t-meta);
        font-weight: var(--w-semibold);
        color: var(--ink);
      }

      /* Connector between cards. Decorative, and only where there is a gap
         wide enough to sit in. */
      .jc__arrow { display: none; }

      @media (min-width: 56rem) {
        .jc__arrow {
          display: grid;
          place-items: center;
          position: absolute;
          top: 50%;
          left: 100%;
          margin-left: calc(var(--s-6) / 2);
          translate: -50% -50%;
          width: 1.6rem;
          height: 1.6rem;
          border-radius: var(--r-full);
          background: var(--ui);
          color: #fff;
          z-index: 1;
        }
      }

      /* ---------- challenge + project ---------- */
      .challenge {
        display: grid;
        gap: var(--s-6);
        align-items: center;
        padding: var(--s-6);
        background: color-mix(in srgb, var(--ui) 5%, var(--surface));
        border: var(--hairline) solid var(--ui-edge);
        border-radius: var(--r-lg);
      }

      @media (min-width: 58rem) {
        .challenge { grid-template-columns: 1fr 1fr; }
      }

      .challenge h2,
      .project h2 {
        margin: 0 0 var(--s-2);
        font-size: 1.625rem;
        font-weight: var(--w-bold);
        letter-spacing: var(--tr-heading);
      }

      .challenge__sub {
        margin: 0 0 var(--s-3);
        font-weight: var(--w-semibold);
        color: var(--ink);
      }

      .challenge p,
      .project p {
        margin: 0 0 var(--s-4);
        color: var(--ink-muted);
        font-size: var(--t-meta);
        line-height: 1.6;
      }

      .project {
        display: grid;
        gap: var(--s-6);
        align-items: center;
        margin-top: var(--s-5);
        padding: var(--s-6);
        background: var(--surface);
        border: var(--hairline) solid var(--rule);
        border-radius: var(--r-lg);
      }

      @media (min-width: 58rem) {
        .project { grid-template-columns: 1.2fr 1fr; }
      }

      .project__facts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--s-2);
      }

      .project__facts li {
        display: grid;
        gap: 0.1rem;
        padding: var(--s-3);
        background: var(--ground);
        border-radius: var(--r-md);
        font-size: var(--t-small);
        color: var(--ink-muted);
      }

      .project__facts strong {
        font-size: var(--t-micro);
        letter-spacing: var(--tr-label);
        text-transform: uppercase;
        color: var(--ui);
      }

      /* ---------- resources ---------- */
      .res {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--s-4);
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      }

      .res li { margin: 0; }

      .res a {
        display: grid;
        gap: var(--s-2);
        align-content: start;
        height: 100%;
        padding: var(--s-4);
        background: var(--surface);
        border: var(--hairline) solid var(--rule);
        border-radius: var(--r-lg);
        text-decoration: none;
        transition:
          border-color var(--dur-fast) var(--ease),
          background-color var(--dur-fast) var(--ease);
      }

      .res a:hover {
        border-color: var(--ui-edge);
        background: var(--ui-tint);
      }

      .res__icon {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--r-md);
        background: var(--ui-tint);
        color: var(--ui);
      }

      .res strong {
        font-size: var(--t-meta);
        font-weight: var(--w-semibold);
        color: var(--ink);
      }

      .res__blurb {
        font-size: var(--t-small);
        color: var(--ink-faint);
        line-height: 1.45;
      }

      /* ---------- footer ---------- */
      .lp__footer {
        padding: var(--s-6) var(--s-5);
        background: var(--ground);
        border-top: var(--hairline) solid var(--rule);
        text-align: center;
      }

      .lp__footer p {
        margin: 0;
        font-size: var(--t-small);
        color: var(--ink-faint);
      }
    </style>
  </body>
</html>
