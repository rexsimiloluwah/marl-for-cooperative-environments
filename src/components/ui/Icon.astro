  check: 'M4.5 12.5 9 17l10.5-10.5',
  external: 'M14 4h6v6M20 4l-8.5 8.5M18 14v5a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6h5',
};

interface Props {
  name: string;
  size?: number;
  /** Give the icon an accessible name. Only for icon-only controls. */
  label?: string;
  class?: string;
}

const { name, size = 16, label, class: className } = Astro.props;

const d = PATHS[name];
if (!d && import.meta.env.DEV) {
  console.warn(
    `[Icon] unknown icon "${name}". Available: ${Object.keys(PATHS).join(', ')}`
  );
}
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  focusable="false"
>
  {label && <title>{label}</title>}
  {/* An unknown name renders a neutral dot rather than nothing, so a typo is
      visible in the layout instead of silently collapsing it. */}
  <path d={d ?? 'M12 10.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z'} />
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
