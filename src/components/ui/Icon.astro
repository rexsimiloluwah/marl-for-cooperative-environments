---
/**
 * ICON
 *
 * A small inline SVG set, drawn in a consistent 24x24 stroke style so the
 * navigation reads as one family. Inline rather than a sprite sheet or an
 * icon package because the count is small and fixed, and because an icon in
 * the critical path of the sidebar should not cost a network request.
 *
 * Icons here are decorative: the adjacent text always carries the meaning,
 * so every icon is aria-hidden. Pass `label` only for an icon that is the
 * sole content of a control, which makes it an image with an accessible name.
 */

const PATHS: Record<string, string> = {
